category = "music"
difficulty = 2
hint = "Er komponierte seine schönste Musik, nachdem er nicht mehr hören konnte!"
explanation = "Ludwig van Beethoven wurde taub, aber er schrieb immer noch großartige Musik! Seine 9. Symphonie gehört zu den besten Werken der Klassik."
