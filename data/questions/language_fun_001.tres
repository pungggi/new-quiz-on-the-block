[ext_resource type="Script" path="res://scripts/data/quiz_question.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
question = "Welche Sprache wird von den meisten Menschen gesprochen?"
answers = PackedStringArray("Englisch", "Spanisch", "Chinesisch (Mandarin)")
