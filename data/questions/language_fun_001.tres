category = "language"
difficulty = 2
hint = "Über 1 Milliarde Menschen sprechen diese Sprache!"
explanation = "Chinesisch (Mandarin) wird von über 1 Milliarde Menschen als Muttersprache gesprochen! Es ist die meistgesprochene Sprache der Welt."
